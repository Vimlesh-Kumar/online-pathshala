{
  "name": "online-pathshala",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run start --workspace=backend",
    "dev": "concurrently \"npm run start --workspace=frontend\" \"npm run start --workspace=backend\"",
    "client": "npm run start --workspace=frontend",
    "server": "npm run start --workspace=backend",
    "c": "cd frontend && npm install",
    "b": "cd backend && npm install",
    "nodePackage": "concurrently  \"npm run c\" \"npm run b\"",
    "build": "npm run build --workspace=frontend"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}