# ─────────────────────────────────────────────────────────────
# Online Pathshala — backend environment
# Copy to `.env` for local dev. In production (Render) set these as
# dashboard env vars instead of committing a file.
# ─────────────────────────────────────────────────────────────

# Port the API listens on (Render injects its own PORT automatically).
APP_PORT=8000

# Long random string used to sign JWTs. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Restrict CORS to your deployed frontend (optional; omit to allow all origins).
# CORS_ORIGIN=https://your-frontend.vercel.app

# ── Option A: Local MySQL ────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
MYSQL_DATABASE=online_pathshala
# Only for local connections over a unix socket (leave unset for TCP/hosted DBs).
# DB_SOCKET_PATH=/tmp/mysql.sock

# ── Option B: Aiven for MySQL (free) — comment out Option A and use this ──
# DB_HOST=your-service.aivencloud.com
# DB_PORT=23704
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password
# MYSQL_DATABASE=defaultdb
# DB_SSL=true
# Paste the Aiven CA certificate (ca.pem) contents to verify TLS (recommended).
# Newlines can be escaped as \n on a single line.
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

# ── AI support (optional — free tier, no billing) ──
# Powers the support chatbot / course Q&A / writing assistant with a real LLM
# (Groq's free tier running Llama 3.3) instead of just keyword matching.
# Get a free key at https://console.groq.com/keys (no credit card required).
# Leave unset and everything still works — it automatically falls back to
# the built-in rule-based FAQ/keyword engine at zero cost.
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Drive (optional — only needed for video/lecture uploads) ──
# Either point to a local key file (backend/googlekey.json) automatically,
# or paste the full service-account JSON here for hosted deploys:
# GOOGLE_CREDENTIALS={"type":"service_account", ...}
# GDRIVE_FOLDER_ID=your_drive_folder_id

# ── Valkey Cache (via Aiven) ────────────────────────────────────
# Redis-compatible cache service for sessions, rate limiting, and data caching.
# Sign up at https://aiven.io and create a Valkey service.
VALKEY_HOST=your-service.aivencloud.com
VALKEY_PORT=23627
VALKEY_PASSWORD=your_aiven_valkey_password
# Optional: Name of the secret in Azure Key Vault to fetch the password from
VALKEY_SECRET_NAME=valkey-password

# ── Azure Key Vault (optional — for secure secret management) ──────
# Store sensitive data (API keys, passwords, DB credentials) securely.
# Leave AZURE_KEYVAULT_ENABLED=false to use .env values directly.
# Set to true and configure credentials to enable Key Vault integration.
AZURE_KEYVAULT_ENABLED=false
AZURE_KEYVAULT_URL=https://your-keyvault-name.vault.azure.net/

# Azure authentication method:
# Option 1 (recommended in production): Use Managed Identity (no credentials needed)
# Option 2 (development): Use Service Principal (set all three below)
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_TENANT_ID=your-tenant-id
