{
  "name": "backend",
  "version": "1.0.0",
  "description": "Online Pathshala Backend",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node scripts/db-bootstrap.js",
    "catalog:generate": "node scripts/generate-course-catalog.js",
    "db-up-dev": "db-migrate up --config ./database/config/dev.json -e dev",
    "db-down-dev": "db-migrate down --config ./database/config/dev.json -e dev",
    "db-up-prod": "db-migrate up --config ./database/config/dev.json -e prod",
    "db-down-prod": "db-migrate down --config ./database/config/dev.json -e prod"
  },
  "keywords": [],
  "author": "Vimlesh Kumar",
  "license": "ISC",
  "dependencies": {
    "@vercel/blob": "2.6.1",
    "bcrypt": "6.0.0",
    "body-parser": "2.3.0",
    "cors": "2.8.6",
    "db-migrate-mysql": "3.0.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "googleapis": "171.4.0",
    "jsonwebtoken": "9.0.3",
    "knex": "3.3.0",
    "mysql2": "3.23.0"
  },
  "devDependencies": {
    "db-migrate": "0.11.14",
    "nodemon": "3.1.14"
  }
}
