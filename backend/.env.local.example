# ─────────────────────────────────────────────────────────────
# Online Pathshala — Local Development Environment
#
# INSTRUCTIONS:
# 1. Copy this file to `.env.local` in the backend directory
# 2. Fill in your local values (database, API keys, etc.)
# 3. NEVER commit `.env.local` to git (it's in .gitignore)
# 4. Run: `npm run dev` to start the server
#
# This file is for LOCAL development ONLY.
# No Azure Key Vault is used locally.
# ─────────────────────────────────────────────────────────────

# ════════════════════════════════════════════════════════════
# ESSENTIAL CONFIGURATION
# ════════════════════════════════════════════════════════════

# Environment (MUST be "development" to disable Key Vault)
NODE_ENV=development

# Server Port
APP_PORT=8000

# CORS - Allow requests from your frontend
CORS_ORIGIN=http://localhost:3000

# ════════════════════════════════════════════════════════════
# AUTHENTICATION & SECURITY
# ════════════════════════════════════════════════════════════

# JWT Secret (generate new one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# For local development, this simple value is fine:
JWT_SECRET=local-dev-jwt-secret-change-this-in-production-1234567890

# ════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION (Local MySQL)
# ════════════════════════════════════════════════════════════

# Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=NewPassword123
MYSQL_DATABASE=online_pathshala

# Only if using Unix socket (macOS/Linux)
# DB_SOCKET_PATH=/tmp/mysql.sock

# ════════════════════════════════════════════════════════════
# CACHE: VALKEY / REDIS
# ════════════════════════════════════════════════════════════

# If you have a local Redis/Valkey running:
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=

# If you want to use Aiven Valkey (same as production):
# VALKEY_HOST=vim-kv-dev-vimlesh11072000-5930.a.aivencloud.com
# VALKEY_PORT=23627
# VALKEY_PASSWORD=your-aiven-password-here
# VALKEY_SECRET_NAME=valkey-password

# ════════════════════════════════════════════════════════════
# STORAGE: VERCEL BLOB
# ════════════════════════════════════════════════════════════

BLOB_STORE_ID=your_vercel_store_id_here
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# ════════════════════════════════════════════════════════════
# AI SUPPORT: GROQ (Optional)
# ════════════════════════════════════════════════════════════

# Get free key at: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# ════════════════════════════════════════════════════════════
# GOOGLE DRIVE (Optional - for video/lecture uploads)
# ════════════════════════════════════════════════════════════

# Option 1: Point to local key file
# GOOGLE_CREDENTIALS={"type":"service_account", ...}
# GDRIVE_FOLDER_ID=your_drive_folder_id

# ════════════════════════════════════════════════════════════
# AZURE KEY VAULT (DISABLED for Local Development)
# ════════════════════════════════════════════════════════════

# Key Vault is DISABLED locally - all secrets come from this .env.local file
AZURE_KEYVAULT_ENABLED=false

# Uncomment only if testing Key Vault locally:
# AZURE_KEYVAULT_URL=https://your-keyvault-name.vault.azure.net/
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_TENANT_ID=your-tenant-id

# ════════════════════════════════════════════════════════════
# TESTING / DEBUGGING
# ════════════════════════════════════════════════════════════

# Debug logging (set to 'true' to enable)
# DEBUG=online-pathshala:*
