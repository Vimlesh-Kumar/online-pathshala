# ─────────────────────────────────────────────────────────────
# Online Pathshala — Local Development Environment
#
#   1. Copy this file to `.env.local`
#   2. Fill in the values below
#   3. Verify with: npm run secrets:check
#   4. Start with:  npm run dev
#
# `.env.local` is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_PORT=8000
CORS_ORIGIN=http://localhost:3000


# ── Authentication ───────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=local-dev-jwt-secret-replace-me

# ── Database (local MySQL) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
MYSQL_DATABASE=online_pathshala
# DB_SOCKET_PATH=/tmp/mysql.sock

# ── Cache: Valkey / Redis ────────────────────────────────────
# Give EITHER a full Service URI, OR host/port/password separately.
#
# Aiven: copy the "Service URI" straight from the console overview page.
# The rediss:// scheme turns on TLS, and it already contains the user and password.
# VALKEY_URI=rediss://default:<password>@vim-kv-dev-vimlesh11072000-5930.c.aivencloud.com:23705

# Local redis-server (no TLS, no password):
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=

# Separate-parts form for Aiven (TLS is enabled automatically for remote hosts):
# VALKEY_HOST=vim-kv-dev-vimlesh11072000-5930.c.aivencloud.com
# VALKEY_PORT=23705
# VALKEY_USERNAME=default
# VALKEY_PASSWORD=your-aiven-valkey-password
# VALKEY_TLS=true    # only needed to force TLS on/off

# ── Storage: Vercel Blob (optional) ──────────────────────────
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# ── AI support: Groq (optional) ──────────────────────────────
# Free key at https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Drive: lecture uploads (optional) ─────────────────
# GOOGLE_CREDENTIALS={"type":"service_account", ...}
# GDRIVE_FOLDER_ID=
