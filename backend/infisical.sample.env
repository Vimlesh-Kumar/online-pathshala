# ─────────────────────────────────────────────────────────────────────────────
# Online Pathshala — Infisical import file
#
# HOW TO USE
#   1. cp infisical.sample.env infisical.env     ← infisical.env is git-ignored
#   2. Fill in the real values in infisical.env
#   3. https://app.infisical.com → your project → pick the environment (prod)
#   4. Secrets → "Add Secret" ▾ → Import / drag infisical.env in
#   5. Delete infisical.env afterwards — Infisical is the store now.
#
# WHAT NOT TO PUT HERE
#   The INFISICAL_* variables are deliberately absent. They are the credentials
#   used to *read* this project, so they live on the host (Render → Environment),
#   never inside Infisical. On Render that is only INFISICAL_CLIENT_ID and
#   INFISICAL_CLIENT_SECRET — render.yaml pins the project id and environment.
#
#   Nothing in this file belongs on Render either: a host variable overrides
#   Infisical, so a copy left there would shadow the value you rotate here.
#
# Lines starting with # are comments and are not imported. Anything marked
# "optional" can be deleted if you do not use that feature — the app degrades
# gracefully without it.
# ─────────────────────────────────────────────────────────────────────────────


# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production

# Render injects its own PORT; this is only used elsewhere.
APP_PORT=8000

# Lock the API to your deployed frontend. Omit to allow all origins.
CORS_ORIGIN=https://your-frontend.vercel.app


# ── Authentication (REQUIRED) ────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-the-64-byte-hex-string-the-command-above-prints


# ── Database — MySQL (REQUIRED) ──────────────────────────────────────────────
DB_HOST=your-service.your-provider.com
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
MYSQL_DATABASE=defaultdb

# Hosted databases require TLS. Set DB_SSL=true when you have no CA to pin,
# or paste the provider's ca.pem into DB_CA_CERT to verify the certificate
# properly (recommended). Newlines must be escaped as \n on a single line.
DB_SSL=REQUIRED
DB_CA_CERT=-----BEGIN CERTIFICATE-----
MIIE...paste-your-providers-ca.pem-here...
-----END CERTIFICATE-----


# ── Cache — Valkey / Redis (optional; caching is skipped without it) ─────────
# Either the whole Service URI:
VALKEY_URI=rediss://default:your-password@your-service.aivencloud.com:23705
# ...or the individual parts instead (delete VALKEY_URI if you use these):
# VALKEY_HOST=your-service.aivencloud.com
# VALKEY_PORT=23705
# VALKEY_USERNAME=default
# VALKEY_PASSWORD=your-password


# ── AI features — Groq (optional, free tier) ─────────────────────────────────
# Powers AI flashcards, practice questions and the support chatbot.
# Without it, every AI feature falls back to its rule-based path.
# Free key (no card): https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_with_your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile


# ── YouTube Data API (optional) ──────────────────────────────────────────────
# Only enriches YouTube *channel* links on the profile page.
# Video links work without it.
YOUTUBE_API_KEY=replace-or-delete-this-line


# ── File storage — Vercel Blob (optional; used for avatar uploads) ───────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
BLOB_STORE_ID=store_replace_me


# ── Google Drive (optional; only for video/lecture uploads) ──────────────────
# The full service-account JSON, on one line.
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
GDRIVE_FOLDER_ID=your-drive-folder-id
